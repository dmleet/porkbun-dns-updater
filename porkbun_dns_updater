#!/bin/bash
#
# Porkbun DNS Updater
#
# Keeps the A records for a list of subdomains pointed at this host's public
# IPv4 address. Records it creates or adopts are tagged with a marker in their
# Porkbun notes, so removing a subdomain from SUB_DOMAINS deletes only records
# this updater manages and never anything added by hand.
#
# Runs as a loop (Docker) or a single pass with RUN_ONCE=true (Kubernetes
# CronJob), exiting non-zero when the pass fails.

set -uo pipefail

# Read VAR, or the contents of the file named by VAR_FILE (for Docker secrets)
read_secret() {
    local file_var="${1}_FILE"
    if [[ -n "${!file_var:-}" ]]; then
        tr -d '\r\n' < "${!file_var}"
    else
        printf '%s' "${!1:-}"
    fi
}

is_true() {
    [[ "${1,,}" =~ ^(true|yes|1)$ ]]
}

# Config (read from environment; secrets are passed to curl via a config fd so
# they never appear in process arguments)
domain="${DOMAIN:-}"
domain="${domain,,}"
readonly domain="${domain%.}"
readonly subdomains_raw="${SUB_DOMAINS:-@}"
api_key="$(read_secret API_KEY)"
api_secret="$(read_secret API_SECRET)"
readonly api_key api_secret
readonly interval="${INTERVAL:-600}"
readonly ttl="${TTL:-600}"
readonly create_records="${CREATE_RECORDS:-true}"
readonly delete_records="${DELETE_RECORDS:-true}"
readonly managed_tag="${MANAGED_TAG:-porkbun-dns-updater}"
readonly dry_run="${DRY_RUN:-false}"
readonly run_once="${RUN_ONCE:-false}"
readonly log_level="${LOG_LEVEL:-info}"
log_format="${LOG_FORMAT:-text}"
readonly log_format="${log_format,,}"
readonly pushgateway_url="${PUSHGATEWAY_URL:-}"
readonly health_file="${HEALTH_FILE:-/tmp/porkbun-dns-updater.health}"
readonly app_version="${APP_VERSION:-dev}"

# Porkbun API endpoints. The IPv4-only host is used for IP detection so an
# IPv6-capable network still reports the address that belongs in an A record.
readonly api_base_url="${API_BASE_URL:-https://api.porkbun.com/api/json/v3}"
readonly ip_urls="${IP_URLS:-https://api-ipv4.porkbun.com/api/json/v3/ip https://api.ipify.org https://ipv4.icanhazip.com}"
readonly max_api_attempts=3
readonly managed_marker="[managed-by:${managed_tag}]"

# Docker HEALTHCHECK: healthy if a sync cycle succeeded recently
if [[ "${1:-}" == "--healthcheck" ]]; then
    [[ "${interval}" =~ ^[0-9]+$ && -r "${health_file}" ]] || exit 1
    last_success=$(cat "${health_file}")
    [[ "${last_success}" =~ ^[0-9]+$ ]] || exit 1
    (( $(date +%s) - last_success <= interval * 3 + 60 ))
    exit
fi

# log LEVEL MESSAGE [key=value ...]
# Text format prints the message; JSON format (for Loki) also includes the
# fields, so queries can filter on e.g. event="record_updated".
log() {
    local level=$1 message=$2 field
    shift 2
    if [[ "${level}" == DEBUG && "${log_level,,}" != debug ]]; then
        return
    fi
    if [[ "${log_format}" == json ]]; then
        local -a args=(--arg ts "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" --arg level "${level,,}" --arg msg "${message}" --arg domain "${domain}")
        for field in "$@"; do
            args+=(--arg "${field%%=*}" "${field#*=}")
        done
        jq -nc "${args[@]}" '$ARGS.named' >&2
    else
        printf '%s [%s] %s\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')" "${level}" "${message}" >&2
    fi
}

# Exit; in loop mode pause first so a restart policy does not spin on a bad
# config
fatal() {
    log ERROR "$@"
    is_true "${run_once}" || sleep 30
    exit 1
}

# Interruptible sleep so SIGTERM (docker stop) is handled promptly
nap() {
    sleep "$1" &
    wait $!
}

new_uuid() {
    cat /proc/sys/kernel/random/uuid 2>/dev/null || printf '%s-%s-%s\n' "$(date +%s)" "$$" "${RANDOM}"
}

# ---------------------------------------------------------------------------
# Validation
# ---------------------------------------------------------------------------

readonly domain_re='^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)+$'
readonly subdomain_re='^(\*|[a-z0-9_]([a-z0-9_-]{0,61}[a-z0-9_])?)(\.[a-z0-9_]([a-z0-9_-]{0,61}[a-z0-9_])?)*$'
readonly key_re='^[A-Za-z0-9_-]+$'

declare -a subdomains=()

validate_config() {
    local -a errors=() raw=()
    local -A seen=()
    local sub

    [[ -n "${domain}" ]] || errors+=("DOMAIN is not set")
    [[ -z "${domain}" || "${domain}" =~ ${domain_re} ]] || errors+=("DOMAIN '${domain}' is not a valid domain name")
    [[ -n "${api_key}" ]] || errors+=("API_KEY is not set")
    [[ -z "${api_key}" || "${api_key}" =~ ${key_re} ]] || errors+=("API_KEY contains unexpected characters")
    [[ -n "${api_secret}" ]] || errors+=("API_SECRET is not set")
    [[ -z "${api_secret}" || "${api_secret}" =~ ${key_re} ]] || errors+=("API_SECRET contains unexpected characters")
    [[ "${interval}" =~ ^[0-9]+$ ]] && (( interval >= 60 )) || errors+=("INTERVAL must be an integer of at least 60 seconds")
    [[ "${ttl}" =~ ^[0-9]+$ ]] || errors+=("TTL must be an integer number of seconds")
    [[ "${managed_tag}" =~ ^[A-Za-z0-9._-]+$ ]] || errors+=("MANAGED_TAG may only contain letters, digits, '.', '_' and '-'")
    [[ "${log_format}" =~ ^(text|json)$ ]] || errors+=("LOG_FORMAT must be text or json")

    # Normalize the comma-separated subdomains: trim, lowercase, dedupe
    IFS=',' read -r -a raw <<< "${subdomains_raw}"
    for sub in "${raw[@]}"; do
        sub="${sub//[[:space:]]/}"
        sub="${sub,,}"
        [[ -n "${sub}" ]] || continue
        if [[ -n "${domain}" && ( "${sub}" == "${domain}" || "${sub}" == *".${domain}" ) ]]; then
            errors+=("SUB_DOMAINS entry '${sub}' includes the domain; list only the subdomain part (or '@' for the apex)")
            continue
        fi
        if [[ "${sub}" != "@" && ! "${sub}" =~ ${subdomain_re} ]]; then
            errors+=("SUB_DOMAINS entry '${sub}' is not a valid subdomain (use '@' for the apex, and omit the domain)")
            continue
        fi
        [[ -z "${seen[${sub}]:-}" ]] || continue
        seen[${sub}]=1
        subdomains+=("${sub}")
    done
    (( ${#subdomains[@]} > 0 )) || errors+=("SUB_DOMAINS does not contain any subdomains")

    if (( ${#errors[@]} > 0 )); then
        local e
        for e in "${errors[@]}"; do
            log ERROR "Config: ${e}" event=config_error
        done
        fatal "Invalid configuration, exiting" event=fatal
    fi
}

# Public IPv4 only: rejects private, loopback, link-local, CGNAT and multicast
is_public_ipv4() {
    local ip=$1 a b c d
    [[ "${ip}" =~ ^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})$ ]] || return 1
    a=$((10#${BASH_REMATCH[1]})) b=$((10#${BASH_REMATCH[2]}))
    c=$((10#${BASH_REMATCH[3]})) d=$((10#${BASH_REMATCH[4]}))
    (( a <= 255 && b <= 255 && c <= 255 && d <= 255 )) || return 1
    (( a == 0 || a == 10 || a == 127 || a >= 224 )) && return 1
    (( a == 169 && b == 254 )) && return 1
    (( a == 172 && b >= 16 && b <= 31 )) && return 1
    (( a == 192 && b == 168 )) && return 1
    (( a == 100 && b >= 64 && b <= 127 )) && return 1
    return 0
}

# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------

curl_auth_config() {
    printf 'header = "X-API-Key: %s"\nheader = "X-Secret-API-Key: %s"\n' "${api_key}" "${api_secret}"
}

# Write the curl URL via a config fd so credentials in URLs stay out of `ps`
curl_url() {
    printf 'url = "%s"\n' "$1"
}

header_value() {
    grep -i "^$1:" "${work_dir}/headers" 2>/dev/null | tail -n 1 | cut -d: -f2- | tr -d ' \r'
}

# api_request METHOD PATH [JSON_BODY]
# Calls the Porkbun API with header auth, retrying transient failures (network
# errors, HTTP 429/5xx, or errors Porkbun marks retryable). Writes carry an
# Idempotency-Key that is reused across retries, so a retried write is applied
# at most once. Sets api_http, api_body, api_error and api_error_code.
# Returns 0 when Porkbun reports SUCCESS.
api_request() {
    local method=$1 path=$2 body=${3:-}
    local attempt=1 rc delay retryable retry_after
    local -a extra=()
    api_http="" api_body="" api_error="" api_error_code=""

    if [[ "${method}" == POST ]]; then
        [[ -n "${body}" ]] || body='{}'
        extra=(-H 'Content-Type: application/json' -H "Idempotency-Key: $(new_uuid)" --data-binary "${body}")
    fi

    while true; do
        api_http=$(curl -sS --max-time 30 -X "${method}" \
            -K <(curl_auth_config) \
            -H 'Accept: application/json' \
            "${extra[@]}" \
            -D "${work_dir}/headers" -o "${work_dir}/body" -w '%{http_code}' \
            "${api_base_url}${path}" 2>"${work_dir}/curl_err")
        rc=$?
        api_body=$(cat "${work_dir}/body" 2>/dev/null)
        : > "${work_dir}/body"
        api_error="" api_error_code=""
        retryable=false

        if (( rc != 0 )); then
            api_error="request failed: $(head -c 300 "${work_dir}/curl_err")"
            retryable=true
        elif [[ "${api_http}" == 2* ]] && jq -e '.status == "SUCCESS"' >/dev/null 2>&1 <<< "${api_body}"; then
            return 0
        else
            if jq -e 'type == "object"' >/dev/null 2>&1 <<< "${api_body}"; then
                api_error_code=$(jq -r '.code // empty' <<< "${api_body}")
                api_error=$(jq -r '([.code, .message] | map(select(. != null and . != "")) | join(": "))
                    + (if (.next_action.hint // "") != "" then " (\(.next_action.hint))" else "" end)' <<< "${api_body}")
                if jq -e '.next_action.retryable == true' >/dev/null 2>&1 <<< "${api_body}"; then
                    retryable=true
                fi
            fi
            api_error="HTTP ${api_http}${api_error:+ ${api_error}}"
            [[ "${api_http}" == 429 || "${api_http}" == 5* ]] && retryable=true
        fi

        if [[ "${retryable}" != true ]] || (( attempt >= max_api_attempts )); then
            return 1
        fi

        delay=$(( 5 * 3 ** (attempt - 1) ))
        if [[ "${api_http}" == 429 ]]; then
            retry_after=$(header_value Retry-After)
            if [[ "${retry_after}" =~ ^[0-9]+$ ]]; then
                delay=$(( retry_after > 300 ? 300 : retry_after ))
            fi
        fi
        log WARN "${method} ${path} failed (${api_error}); retry ${attempt}/$((max_api_attempts - 1)) in ${delay}s" \
            event=api_retry method="${method}" path="${path}" http_status="${api_http}" error="${api_error}" error_code="${api_error_code}"
        nap "${delay}"
        attempt=$((attempt + 1))
    done
}

# api_write PATH JSON_BODY
# POSTs a DNS change, adding dryRun when DRY_RUN is set and logging any
# warnings Porkbun returns (e.g. the domain is not delegated to Porkbun, so
# the write will not affect what resolves).
api_write() {
    local path=$1 body=$2 warning
    if is_true "${dry_run}"; then
        body=$(jq -c '. + {dryRun: true}' <<< "${body}")
    fi
    api_request POST "${path}" "${body}" || return 1

    while IFS= read -r warning; do
        [[ -n "${warning}" ]] && log WARN "Porkbun: ${warning}" event=porkbun_warning path="${path}"
    done < <(jq -r '.warnings[]? | if type == "string" then . else tostring end' <<< "${api_body}")

    if is_true "${dry_run}" && jq -e '.wouldSucceed == false' >/dev/null 2>&1 <<< "${api_body}"; then
        api_error="dry run validation failed: $(jq -r '.message // "no reason given"' <<< "${api_body}")"
        return 1
    fi
    return 0
}

# ---------------------------------------------------------------------------
# Metrics
# ---------------------------------------------------------------------------

# Push the results of a check to a Prometheus Pushgateway. POST replaces only
# the metrics sent, so the last success timestamp survives failed runs.
push_metrics() {
    [[ -n "${pushgateway_url}" ]] || return 0
    local success=$1 now action payload
    now=$(date +%s)

    payload="# TYPE porkbun_dns_updater_last_run_timestamp_seconds gauge
porkbun_dns_updater_last_run_timestamp_seconds ${now}
# TYPE porkbun_dns_updater_last_run_success gauge
porkbun_dns_updater_last_run_success ${success}
# TYPE porkbun_dns_updater_last_run_duration_seconds gauge
porkbun_dns_updater_last_run_duration_seconds ${cycle_duration}
# TYPE porkbun_dns_updater_build_info gauge
porkbun_dns_updater_build_info{version=\"${app_version}\"} 1
# TYPE porkbun_dns_updater_records gauge
"
    for action in created updated adopted deleted unchanged failed; do
        payload+="porkbun_dns_updater_records{action=\"${action}\"} ${stats[${action}]:-0}
"
    done
    if (( success == 1 )); then
        payload+="# TYPE porkbun_dns_updater_last_success_timestamp_seconds gauge
porkbun_dns_updater_last_success_timestamp_seconds ${now}
"
    fi
    if [[ -n "${last_ip}" ]]; then
        payload+="# TYPE porkbun_dns_updater_public_ip_info gauge
porkbun_dns_updater_public_ip_info{ip=\"${last_ip}\"} 1
"
    fi

    curl -sS --max-time 15 --fail -o /dev/null -X POST \
        -K <(curl_url "${pushgateway_url%/}/metrics/job/porkbun_dns_updater/domain/${domain}") \
        --data-binary "${payload}" \
        || log WARN "Failed to push metrics to Pushgateway" event=metrics_push_failed
}

# ---------------------------------------------------------------------------
# DNS sync
# ---------------------------------------------------------------------------

get_public_ip() {
    local url out ip
    local -a urls=()
    read -r -a urls <<< "${ip_urls}"
    for url in "${urls[@]}"; do
        if ! out=$(curl -sS -4 --max-time 15 --fail "${url}" 2>&1); then
            log WARN "IP lookup via ${url} failed: ${out:0:200}" event=ip_lookup_failed url="${url}" error="${out:0:200}"
            continue
        fi
        # Porkbun returns JSON with yourIp; the fallbacks return a bare address
        if jq -e 'type == "object"' >/dev/null 2>&1 <<< "${out}"; then
            ip=$(jq -r '.yourIp // .ip // empty' <<< "${out}")
        else
            ip=$(tr -d '[:space:]' <<< "${out}")
        fi
        if is_public_ipv4 "${ip}"; then
            log DEBUG "Public IP ${ip} from ${url}" event=ip_lookup url="${url}" ip="${ip}"
            printf '%s\n' "${ip}"
            return 0
        fi
        log WARN "IP lookup via ${url} returned an invalid or non-public address: '${ip:0:64}'" \
            event=ip_lookup_failed url="${url}" error="invalid or non-public address"
    done
    return 1
}

fqdn_for() {
    if [[ "$1" == "@" ]]; then
        printf '%s\n' "${domain}"
    else
        printf '%s\n' "$1.${domain}"
    fi
}

dry_run_prefix() {
    is_true "${dry_run}" && printf '[dry run] '
}

# Merge the managed marker into existing notes so user notes are kept
tagged_notes() {
    local notes=$1
    printf '%s\n' "${notes:+${notes} }${managed_marker}"
}

create_record() {
    local sub=$1 fqdn=$2 ip=$3 name body
    name="${sub}"
    [[ "${sub}" == "@" ]] && name=""
    body=$(jq -nc --arg name "${name}" --arg ip "${ip}" --argjson ttl "${ttl}" --arg notes "${managed_marker}" \
        '{type: "A", name: $name, content: $ip, ttl: $ttl, notes: $notes}')

    if api_write "/dns/create/${domain}" "${body}"; then
        log INFO "$(dry_run_prefix)Created A record ${fqdn} -> ${ip}" \
            event=record_created fqdn="${fqdn}" new_ip="${ip}" dry_run="${dry_run}"
        stats[created]=$(( ${stats[created]:-0} + 1 ))
        return 0
    fi
    if [[ "${api_error_code}" == DUPLICATE_RECORD ]]; then
        log WARN "A record for ${fqdn} already exists (created concurrently); it will be checked next run" \
            event=record_duplicate fqdn="${fqdn}"
        return 0
    fi
    log ERROR "Failed to create A record ${fqdn}: ${api_error}" \
        event=record_error action=create fqdn="${fqdn}" error="${api_error}" error_code="${api_error_code}"
    return 1
}

# Point an existing record at the current IP and tag it as managed (adopting
# records that were created by hand or by older versions of this updater)
update_record() {
    local record=$1 fqdn=$2 ip=$3 id content notes needs_ip=false needs_tag=false body
    id=$(jq -r '.id' <<< "${record}")
    content=$(jq -r '.content' <<< "${record}")
    notes=$(jq -r '.notes // ""' <<< "${record}")

    [[ "${content}" != "${ip}" ]] && needs_ip=true
    [[ "${notes}" != *"${managed_marker}"* ]] && needs_tag=true

    if [[ "${needs_ip}" == false && "${needs_tag}" == false ]]; then
        log DEBUG "No update needed for ${fqdn} (record ${id})" event=record_unchanged fqdn="${fqdn}" record_id="${id}"
        stats[unchanged]=$(( ${stats[unchanged]:-0} + 1 ))
        return 0
    fi

    # Edit by ID only changes the fields that are sent
    body=$(jq -nc \
        --arg ip "${ip}" --argjson set_ip "${needs_ip}" \
        --arg notes "$(tagged_notes "${notes}")" --argjson set_notes "${needs_tag}" \
        '(if $set_ip then {content: $ip} else {} end) + (if $set_notes then {notes: $notes} else {} end)')

    if ! api_write "/dns/edit/${domain}/${id}" "${body}"; then
        log ERROR "Failed to update A record ${fqdn} (record ${id}): ${api_error}" \
            event=record_error action=update fqdn="${fqdn}" record_id="${id}" error="${api_error}" error_code="${api_error_code}"
        return 1
    fi
    if [[ "${needs_ip}" == true ]]; then
        log INFO "$(dry_run_prefix)Updated A record ${fqdn} from ${content} to ${ip}" \
            event=record_updated fqdn="${fqdn}" record_id="${id}" old_ip="${content}" new_ip="${ip}" dry_run="${dry_run}"
        stats[updated]=$(( ${stats[updated]:-0} + 1 ))
    else
        log INFO "$(dry_run_prefix)Adopted existing A record ${fqdn} (${content}) as managed" \
            event=record_adopted fqdn="${fqdn}" record_id="${id}" dry_run="${dry_run}"
        stats[adopted]=$(( ${stats[adopted]:-0} + 1 ))
    fi
    return 0
}

delete_record() {
    local record=$1 id fqdn content
    id=$(jq -r '.id' <<< "${record}")
    fqdn=$(jq -r '.name' <<< "${record}")
    content=$(jq -r '.content' <<< "${record}")

    if ! api_write "/dns/delete/${domain}/${id}" '{}'; then
        log ERROR "Failed to delete A record ${fqdn} (record ${id}): ${api_error}" \
            event=record_error action=delete fqdn="${fqdn}" record_id="${id}" error="${api_error}" error_code="${api_error_code}"
        return 1
    fi
    log INFO "$(dry_run_prefix)Deleted managed A record ${fqdn} (${content}); it is no longer in SUB_DOMAINS" \
        event=record_deleted fqdn="${fqdn}" record_id="${id}" old_ip="${content}" dry_run="${dry_run}"
    stats[deleted]=$(( ${stats[deleted]:-0} + 1 ))
    return 0
}

last_ip=""
last_error=""
cycle_duration=0
declare -A stats=()

# One full pass: detect IP, reconcile every listed subdomain, prune stale
# managed records. Returns non-zero if any step failed.
sync_cycle() {
    local ip records sub fqdn matches record desired_json stale
    local -a desired=()
    stats=()

    if ! ip=$(get_public_ip); then
        last_error="unable to determine public IPv4 address from any source"
        return 1
    fi
    if [[ "${ip}" != "${last_ip}" ]]; then
        log INFO "Public IP is ${ip}${last_ip:+ (was ${last_ip})}" event=public_ip ip="${ip}" previous_ip="${last_ip}"
        last_ip="${ip}"
    fi

    if ! api_request GET "/dns/retrieve/${domain}"; then
        last_error="unable to retrieve DNS records: ${api_error}"
        return 1
    fi
    records="${api_body}"

    for sub in "${subdomains[@]}"; do
        fqdn=$(fqdn_for "${sub}")
        desired+=("${fqdn}")
        matches=$(jq -c --arg n "${fqdn}" '.records[] | select(.type == "A" and (.name | ascii_downcase) == $n)' <<< "${records}")

        if [[ -z "${matches}" ]]; then
            if is_true "${create_records}"; then
                create_record "${sub}" "${fqdn}" "${ip}" || stats[failed]=$(( ${stats[failed]:-0} + 1 ))
            else
                log WARN "No A record found for ${fqdn} and CREATE_RECORDS is disabled; skipping" event=record_missing fqdn="${fqdn}"
            fi
            continue
        fi

        while IFS= read -r record; do
            update_record "${record}" "${fqdn}" "${ip}" || stats[failed]=$(( ${stats[failed]:-0} + 1 ))
        done <<< "${matches}"
    done

    if is_true "${delete_records}"; then
        desired_json=$(printf '%s\n' "${desired[@]}" | jq -R . | jq -sc .)
        stale=$(jq -c --arg m "${managed_marker}" --argjson keep "${desired_json}" \
            '.records[] | select(.type == "A" and ((.notes // "") | contains($m)) and ((.name | ascii_downcase) as $n | $keep | any(. == $n) | not))' \
            <<< "${records}")
        if [[ -n "${stale}" ]]; then
            while IFS= read -r record; do
                delete_record "${record}" || stats[failed]=$(( ${stats[failed]:-0} + 1 ))
            done <<< "${stale}"
        fi
    fi

    if (( ${stats[failed]:-0} > 0 )); then
        last_error="${stats[failed]} record operation(s) failed"
        return 1
    fi
    return 0
}

# Fail fast on bad credentials or missing scopes; tolerate network errors
verify_credentials() {
    local scopes
    if api_request GET "/ping"; then
        scopes=$(jq -r '(.scopes // []) | join(",")' <<< "${api_body}")
        log INFO "API credentials valid for account $(jq -r '.account // "unknown"' <<< "${api_body}") (scopes: ${scopes:-unknown})" \
            event=credentials_verified scopes="${scopes}"
        if [[ -n "${scopes}" && ",${scopes}," != *",full,"* ]] && [[ ",${scopes}," != *",read,"* || ",${scopes}," != *",dns,"* ]]; then
            fatal "API key is missing required scopes: it needs both 'read' and 'dns'" event=fatal scopes="${scopes}"
        fi
        return 0
    fi
    if [[ "${api_http}" == 4* && "${api_http}" != 429 ]]; then
        fatal "API credentials were rejected: ${api_error}" event=fatal error="${api_error}" error_code="${api_error_code}"
    fi
    log WARN "Unable to verify API credentials (${api_error}); continuing" event=credentials_unverified error="${api_error}"
}

# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

validate_config

work_dir=$(mktemp -d)
readonly work_dir
trap 'rm -rf "${work_dir}"' EXIT
trap 'log INFO "Received shutdown signal, exiting" event=shutdown; exit 0' TERM INT

log INFO "Porkbun DNS Updater ${app_version} starting for ${domain}: subdomains=$(IFS=,; echo "${subdomains[*]}") create=${create_records} delete=${delete_records} dry_run=${dry_run}" \
    event=startup version="${app_version}" subdomains="$(IFS=,; echo "${subdomains[*]}")" run_once="${run_once}" dry_run="${dry_run}"

verify_credentials

while true; do
    cycle_start=${SECONDS}
    sync_cycle
    rc=$?
    cycle_duration=$(( SECONDS - cycle_start ))
    summary="created=${stats[created]:-0} updated=${stats[updated]:-0} adopted=${stats[adopted]:-0} deleted=${stats[deleted]:-0} unchanged=${stats[unchanged]:-0} failed=${stats[failed]:-0}"

    if (( rc == 0 )); then
        date +%s > "${health_file}"
        push_metrics 1
        log INFO "DNS check complete: ${summary}" event=check_completed status=success duration_seconds="${cycle_duration}" \
            created="${stats[created]:-0}" updated="${stats[updated]:-0}" adopted="${stats[adopted]:-0}" \
            deleted="${stats[deleted]:-0}" unchanged="${stats[unchanged]:-0}" failed=0
    else
        push_metrics 0
        log ERROR "DNS check failed: ${last_error}" event=check_completed status=failure duration_seconds="${cycle_duration}" \
            error="${last_error}" created="${stats[created]:-0}" updated="${stats[updated]:-0}" adopted="${stats[adopted]:-0}" \
            deleted="${stats[deleted]:-0}" unchanged="${stats[unchanged]:-0}" failed="${stats[failed]:-0}"
    fi

    is_true "${run_once}" && exit "${rc}"
    nap "${interval}"
done
